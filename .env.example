DJANGO_DEBUG=false
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=tripleedms.edwinpxmx.my.id,192.168.100.110,localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://tripleedms.edwinpxmx.my.id
DATABASE_URL=postgresql://triplee_dms:replace-with-database-password@db:5432/triplee_dms
TIME_ZONE=Asia/Jakarta

# Local server document storage and branding
MAX_UPLOAD_SIZE_MB=80
DOCUMENT_STORAGE_ROOT=/app/documents
DOCUMENT_STORAGE_DISPLAY_PATH=/DATA/AppData/TRIPLE-E_DMS/data/documents
BRAND_LOGO_PATH=/app/branding/logo.png
BRAND_LOGO_FILE=/DATA/AppData/TRIPLE-E_DMS/logo.png

# Encrypted database backup
BACKUP_ENCRYPTION_KEY=
BACKUP_LOCAL_DIR=/app/backups
BACKUP_DAILY_RETENTION_DAYS=30
BACKUP_MONTHLY_RETENTION_DAYS=365
BACKUP_TIME=02:00

# PostgreSQL container
POSTGRES_DB=triplee_dms
POSTGRES_USER=triplee_dms
POSTGRES_PASSWORD=replace-with-database-password
APP_DATA_DIR=/DATA/AppData/TRIPLE-E_DMS/data
