DJANGO_DEBUG=false
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=tripleedms.edwinpxmx.my.id,192.168.100.110,localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://tripleedms.edwinpxmx.my.id
DATABASE_URL=postgresql://triplee_dms:replace-with-database-password@db:5432/triplee_dms
TIME_ZONE=Asia/Jakarta

# Google Drive OAuth web application
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://tripleedms.edwinpxmx.my.id/integrations/google-drive/callback/
GOOGLE_TOKEN_ENCRYPTION_KEY=
GOOGLE_DRIVE_ROOT_FOLDER=TripleE-DWDM-DMS

# Uploads
MAX_UPLOAD_SIZE_MB=80

# Encrypted database backup
BACKUP_ENCRYPTION_KEY=
BACKUP_LOCAL_DIR=/app/backups
BACKUP_LOCAL_RETENTION_DAYS=7
BACKUP_DRIVE_RETENTION_DAYS=30
BACKUP_DRIVE_MONTHLY_RETENTION_DAYS=365
BACKUP_TIME=02:00

# PostgreSQL container
POSTGRES_DB=triplee_dms
POSTGRES_USER=triplee_dms
POSTGRES_PASSWORD=replace-with-database-password
APP_DATA_DIR=/DATA/AppData/triplee-dwdm-dms
